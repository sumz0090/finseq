        <activity android:name=".PaymentReviewActivity"/>
        <activity android:name=".PoliciesActivity"/>
        <activity android:name=".AccountsActivity"/>
        <activity android:name=".MandatesActivity"/>
        <activity android:name=".OrdersActivity"/>
        <activity android:name=".MfListActivity"/>
        <activity android:name=".InvestActivity"/>
        <activity android:name=".Customer360Activity"/>
        <activity android:name=".ClientsActivity"/>
        <activity android:name=".SecuritySettingsActivity"/>
        <activity android:name=".PdfPreviewActivity"/>
        <activity android:name=".PdfContinuousActivity"/>
        <activity android:name=".PolicyDetailActivity"/>
        <activity android:name=".UccOnboardingActivity"/>
        <activity android:name=".MutualFundActivity"/>
        <activity android:name=".InsuranceActivity"/>
        <activity android:name=".MainActivity"/>
        <activity android:name=".LockActivity"/>
        <activity android:name=".LoginActivity"/>
        <activity android:name=".LauncherActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
