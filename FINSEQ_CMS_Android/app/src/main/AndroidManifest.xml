        <activity android:name=".AttendanceCorrectionActivity"/>
        <activity android:name=".AttendanceSalaryActivity"/>
        <receiver android:name=".AttendanceReminderReceiver" android:exported="false"/>
        <activity android:name=".PhysicalCopyRegisterActivity"/>
        <activity android:name=".DisplaySettingsActivity"/>
        <activity android:name=".MoreActivity"/>
        <activity android:name=".AccountDetailsActivity"/>
        <activity android:name=".ActiveSessionsActivity"/>
        <activity android:name=".SchemesActivity"/>
        <activity android:name=".FamilyToolsActivity"/>
        <activity android:name=".UnassignedPoliciesActivity"/>
        <activity android:name=".PhysicalCopyActivity"/>
        <activity android:name=".UploadPolicyActivity"/>
